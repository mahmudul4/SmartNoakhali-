          "type": "boolean",
          "description": "Whether the account is suspended."
        },
        "must_change_password": {
          "type": "boolean",
          "description": "Whether the user must change password on next login."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "full_name", "username", "phone", "roles", "suspended", "must_change_password", "createdAt", "updatedAt"]
    },
