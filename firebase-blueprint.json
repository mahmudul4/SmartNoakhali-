          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Detailed description."
        },
        "contact": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Phone or contact information."
        },
        "image_url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Image URL or data URL."
