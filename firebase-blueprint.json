          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["author_id", "sender_name", "sender_phone", "method", "trx_id", "amount", "note", "status", "createdAt", "updatedAt"]
    },
