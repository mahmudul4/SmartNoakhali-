          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Parsed Noakhali upazila name."
        },
        "district": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Parsed district name."
        },
        "age": {
          "type": "number",
          "description": "Donor age in years."
        },
        "last_donation_date": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "ISO date of last blood donation."
        },
        "photo_url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000,
          "description": "Donor avatar URL or data URL."
        },
        "total_donations": {
          "type": "number",
          "description": "Total number of blood donations completed."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "minLength": 7,
          "maxLength": 10,
          "description": "Moderation status."
        },
        "import_source": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Optional source dataset identifier for bulk-imported donors."
        },
        "source_row": {
          "type": "number",
          "description": "Original source row number when bulk-imported."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["author_id", "full_name", "phone", "blood_group", "address", "age", "last_donation_date", "photo_url", "total_donations", "status", "createdAt", "updatedAt"]
    },
