{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrator record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified email address of the administrator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of admin creation."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and role assignment record isolated to owner and admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "User email address."
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full display name of the user."
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Unique username handle."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30,
          "description": "Contact phone number."
        },
        "roles": {
          "type": "array",
          "description": "Bounded role list assigned to the user."
        },
        "suspended": {
          "type": "boolean",
          "description": "Whether the account is suspended."
        },
        "must_change_password": {
          "type": "boolean",
          "description": "Whether the user must change password on next login."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "full_name", "username", "phone", "roles", "suspended", "must_change_password", "createdAt", "updatedAt"]
    },
    "SecurityEvent": {
      "title": "SecurityEvent",
      "description": "Audit log entry for a specific user account.",
