    },
    "BloodDonor": {
      "title": "BloodDonor",
      "description": "Registered volunteer blood donor profile.",
      "type": "object",
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user registering the donor."
        },
        "full_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Donor full name."
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "description": "Donor contact phone number."
        },
        "blood_group": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
          "minLength": 2,
          "maxLength": 3,
          "description": "ABO/Rh blood group."
        },
        "address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Donor area or union."
        },
