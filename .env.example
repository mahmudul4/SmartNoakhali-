# ==============================================================================
# Smart Noakhali — Environment Variables Configuration
# ==============================================================================
# Note: For local development, firebase-applet-config.json is used automatically.
# When deploying to Cloudflare Pages / Netlify / Vercel, configure these in the
# platform's Environment Variables dashboard settings.
# ==============================================================================

# Client-Side Firebase Configuration (Prefix VITE_ for Vite bundle exposure)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=beaming-infusion-g8p5g
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_ID=ai-studio-abc-81891269-1dc9-47d5-9e96-0166932d5174

# Server-Side Private Secret (Set in Cloudflare / Server environment only; NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
