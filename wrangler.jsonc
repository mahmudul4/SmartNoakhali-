{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartnoakhali",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "R2_PUBLIC",
      "bucket_name": "smart-noakhali-public",
      "preview_bucket_name": "smart-noakhali-public-preview"
    },
    {
      "binding": "R2_PRIVATE",
      "bucket_name": "smart-noakhali-private",
      "preview_bucket_name": "smart-noakhali-private-preview"
    }
  ]
}
