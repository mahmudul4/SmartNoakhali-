rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Main Admin ONLY (mdmahmudulhashan0@gmail.com)
    function isMainAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "mdmahmudulhashan0@gmail.com" &&
        (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }

    // Ordinary Admin / Editor (requires verified email)
    function isSecondaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "mr.bear444plus@gmail.com";
    }

    function isStaff() {
      return isMainAdmin() || isSecondaryAdmin();
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (
          request.resource.contentType == 'image/jpeg' ||
          request.resource.contentType == 'image/jpg' ||
          request.resource.contentType == 'image/png' ||
          request.resource.contentType == 'image/webp' ||
          request.resource.contentType == 'image/gif' ||
          request.resource.contentType == 'image/svg+xml' ||
          request.resource.contentType == 'image/x-icon'
        );
    }

    function isValidMediaUpload() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 20 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // Public readable assets across the portal
    match /{allImages=**} {
      allow read: if true;
    }

    // User profile avatars — owner or Main Admin only
    match /users/{userId}/avatar/{fileName} {
      allow write: if (isSignedIn() && request.auth.uid == userId && isValidImageUpload()) || (isMainAdmin() && isValidImageUpload());
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isMainAdmin();
    }

    // Staff avatars — owner or Main Admin
    match /staff_avatars/{userId}/{fileName} {
      allow write: if ((isSignedIn() && request.auth.uid == userId) || isMainAdmin() || isStaff()) && isValidImageUpload();
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isMainAdmin();
    }

    // Citizen submissions / directory listings
    match /submissions/{subId}/{fileName} {
      allow write: if isSignedIn() && isValidImageUpload();
      allow delete: if isStaff();
    }

    // Blood donor profile images
    match /donors/{donorId}/{fileName} {
      allow write: if isSignedIn() && isValidImageUpload();
      allow delete: if isStaff();
    }

    // Blood donation event certificates / photos
    match /donor-events/{donorId}/{fileName} {
      allow write: if isSignedIn() && isValidImageUpload();
      allow delete: if isStaff();
    }

    // Protected site settings & logo — Main Admin ONLY
    match /settings/{settingKey}/{fileName} {
      allow write: if isMainAdmin() && isValidImageUpload();
      allow delete: if isMainAdmin();
    }

    // Branding assets (logos, favicons, PWA icons) — Main Admin ONLY
    match /branding/{fileName} {
      allow write: if isMainAdmin() && isValidImageUpload();
      allow delete: if isMainAdmin();
    }

    // Centralized Media & Icon Library — Main Admin ONLY
    match /media_library/{fileName} {
      allow write: if isMainAdmin() && isValidImageUpload();
      allow delete: if isMainAdmin();
    }

    // Category images — Staff / Main Admin
    match /categories/{categorySlug}/{fileName} {
      allow write: if isStaff() && isValidImageUpload();
      allow delete: if isMainAdmin();
    }

    // Hero Banner assets — STRICTLY Main Admin ONLY
    match /banners/hero_banner/{fileName} {
      allow write: if isMainAdmin() && isValidImageUpload();
      allow delete: if isMainAdmin();
    }

    // Other Emergency / Popup banners — Staff / Main Admin
    match /banners/{bannerId}/{fileName} {
      allow write: if (bannerId != "hero_banner" ? isStaff() : isMainAdmin()) && isValidImageUpload();
      allow delete: if bannerId != "hero_banner" ? isStaff() : isMainAdmin();
    }

    // Chat attachments (images, voice recordings, PDFs)
    match /chat/{threadId}/{fileName} {
      allow write: if isSignedIn() && isValidMediaUpload();
      allow delete: if isMainAdmin();
    }

    // General uploads — Authenticated non-anonymous users or staff
    match /uploads/{entityId}/{fileName} {
      allow write: if (isNonAnonymous() || isStaff()) && isValidMediaUpload();
      allow delete: if isMainAdmin();
    }
  }
}
