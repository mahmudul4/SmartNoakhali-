rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Global Hardened Primitives
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Main Admin: ONLY mdmahmudulhashan0@gmail.com
    function isMainAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == "mdmahmudulhashan0@gmail.com";
    }

    // Editor / Ordinary Admin permissions check
    // Ordinary admins get only Editor permissions.
    // They are identified either by having 'editor' or 'admin' in /users/{uid}.data.roles or being Main Admin.
    function isEditor() {
      return isSignedIn() && (
        isMainAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'editor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        ))
      );
    }

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // 1. /admins/{adminId}
    // =========================================================
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isMainAdmin();
    }

    // =========================================================
    // 2. /users/{userId} & Subcollection /security_events
    // =========================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isEditor();
      allow list: if isMainAdmin();
      allow create: if isOwner(userId) && (!('roles' in incoming()) || incoming().roles == ['user']);
      allow update: if isMainAdmin() || (isOwner(userId) && (!incoming().diff(existing()).affectedKeys().hasAny(['roles', 'suspended', 'email'])));
      allow delete: if isMainAdmin();

      match /security_events/{eventId} {
        allow read, write: if isOwner(userId) || isMainAdmin();
      }
    }

    // =========================================================
    // 3. /donations/{donationId}
    // =========================================================
    match /donations/{donationId} {
      allow get, list: if true;
      allow create: if isValidId(donationId);
      allow update, delete: if isMainAdmin();
    }

    // =========================================================
    // 4. /submissions/{submissionId}
    // =========================================================
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isValidId(submissionId);
      allow update: if isEditor() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isEditor();
    }

    // =========================================================
    // 5. /blood_donors/{donorId}
    // =========================================================
    match /blood_donors/{donorId} {
      allow get, list: if true;
      allow create: if isValidId(donorId);
      allow update: if isEditor() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isEditor();
    }

    // =========================================================
    // 6. /donation_events/{eventId}
    // =========================================================
    match /donation_events/{eventId} {
      allow get, list: if true;
      allow create: if isValidId(eventId);
      allow update, delete: if isEditor();
    }

    // =========================================================
    // 7. /emergency_banners/{bannerId}
    // =========================================================
    match /emergency_banners/{bannerId} {
      allow get, list: if true;
      allow write: if isEditor();
    }

    // =========================================================
    // 8. /app_links/{linkId}
    // =========================================================
    match /app_links/{linkId} {
      allow get, list: if true;
      allow write: if isMainAdmin();
    }

    // =========================================================
    // 9. /emergency_blood_requests/{requestId}
    // =========================================================
    match /emergency_blood_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId);
      allow update: if isEditor() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isEditor();
    }

    // =========================================================
    // 10. /category_access/{accessId}
    // =========================================================
    match /category_access/{accessId} {
      allow get, list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
      allow write: if isMainAdmin();
    }

    // =========================================================
    // 11. /category_requests/{requestId}
    // =========================================================
    match /category_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isMainAdmin();
    }

    // =========================================================
    // 12. /payment_requests/{requestId}
    // =========================================================
    match /payment_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isMainAdmin();
    }

    // =========================================================
    // 13. /settings/{settingId} (Site Logo, Categories, Packages, etc.)
    // =========================================================
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isMainAdmin();
    }

    // =========================================================
    // 14. /categories/{categoryId}
    // =========================================================
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isEditor();
    }

    // =========================================================
    // 15. /chat_threads/{threadId} & Subcollection /messages
    // =========================================================
    match /chat_threads/{threadId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isMainAdmin();

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isMainAdmin();
      }
    }
  }
}
