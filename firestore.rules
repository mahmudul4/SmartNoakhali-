rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Global Hardened Primitives
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Main Super Admin
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mdmahmudulhashan0@gmail.com" ||
        request.auth.token.email == "mr.bear444plus@gmail.com"
      );
    }

    // Bootstrapped Admin/Staff
    function isBootstrappedAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          request.auth.token.email == "mr.bear444plus@gmail.com" ||
          request.auth.token.email == "mdmahmudulhashan0@gmail.com"
        )
      );
    }

    // Full Admin Check
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Staff Check
    function isStaff() {
      return isAdmin() || (
        isSignedIn() && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
            'editor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
            'moderator' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
          )) ||
          isBootstrappedAdmin()
        )
      );
    }

    // =========================================================
    // 1. /admins/{adminId}
    // =========================================================
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 2. /users/{userId} & Subcollection /security_events
    // =========================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();
      allow create: if isOwner(userId) || isStaff();
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin() || isBootstrappedAdmin();

      match /security_events/{eventId} {
        allow read, write: if isOwner(userId) || isStaff();
      }
    }

    // =========================================================
    // 3. /donations/{donationId}
    // =========================================================
    match /donations/{donationId} {
      allow get, list: if true;
      allow create: if isValidId(donationId);
      allow update: if isStaff() || isBootstrappedAdmin() || isAdmin() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 4. /submissions/{submissionId}
    // =========================================================
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create: if isValidId(submissionId);
      allow update: if isStaff() || isBootstrappedAdmin() || isAdmin() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 5. /blood_donors/{donorId}
    // =========================================================
    match /blood_donors/{donorId} {
      allow get, list: if true;
      allow create: if isValidId(donorId);
      allow update: if isStaff() || isBootstrappedAdmin() || isAdmin() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 6. /donation_events/{eventId}
    // =========================================================
    match /donation_events/{eventId} {
      allow get, list: if true;
      allow create: if isValidId(eventId);
      allow update: if isStaff() || isBootstrappedAdmin() || isAdmin() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 7. /emergency_banners/{bannerId}
    // =========================================================
    match /emergency_banners/{bannerId} {
      allow get, list: if true;
      allow write: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 8. /app_links/{linkId}
    // =========================================================
    match /app_links/{linkId} {
      allow get, list: if true;
      allow write: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 9. /emergency_blood_requests/{requestId}
    // =========================================================
    match /emergency_blood_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId);
      allow update: if isStaff() || isBootstrappedAdmin() || isAdmin() || (isSignedIn() && existing().author_id == request.auth.uid);
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 10. /category_access/{accessId}
    // =========================================================
    match /category_access/{accessId} {
      allow get, list: if (isSignedIn() && existing().user_id == request.auth.uid) || isStaff() || isBootstrappedAdmin();
      allow write: if isStaff() || isBootstrappedAdmin();
    }

    // =========================================================
    // 11. /category_requests/{requestId}
    // =========================================================
    match /category_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 12. /payment_requests/{requestId}
    // =========================================================
    match /payment_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 13. /settings/{settingId} (Site Logo, Categories, Packages, etc.)
    // =========================================================
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 14. /categories/{categoryId}
    // =========================================================
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isStaff() || isBootstrappedAdmin() || isAdmin();
    }

    // =========================================================
    // 15. /chat_threads/{threadId} & Subcollection /messages
    // =========================================================
    match /chat_threads/{threadId} {
      allow get, list: if isSignedIn() || isStaff();
      allow create, update: if isSignedIn() || isStaff();
      allow delete: if isStaff() || isBootstrappedAdmin() || isAdmin();

      match /messages/{messageId} {
        allow get, list: if isSignedIn() || isStaff();
        allow create: if isSignedIn() || isStaff();
        allow update, delete: if isStaff() || isBootstrappedAdmin() || isAdmin();
      }
    }
  }
}
