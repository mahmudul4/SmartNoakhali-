rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Global Hardened Primitives & Role Hierarchy
    // =========================================================
    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Main Admin ONLY (mdmahmudulhashan0@gmail.com)
    function isMainAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "mdmahmudulhashan0@gmail.com" &&
        (
          request.auth.token.email_verified == true ||
          request.auth.token.firebase.sign_in_provider == 'password'
        );
    }

    // Ordinary / Secondary Admin (mr.bear444plus@gmail.com - requires verified email or password sign-in; never gains Main Admin privileges)
    function isBootstrappedOrdinaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "mr.bear444plus@gmail.com" &&
        (
          request.auth.token.email_verified == true ||
          request.auth.token.firebase.sign_in_provider == 'password'
        );
    }

    function isNonSuspendedStaffDoc(userDoc) {
      return (!('suspended' in userDoc) || userDoc.suspended != true) && (
        ('roles' in userDoc && userDoc.roles is list && (
          'admin' in userDoc.roles ||
          'editor' in userDoc.roles ||
          'moderator' in userDoc.roles
        )) ||
        ('custom_role_id' in userDoc && userDoc.custom_role_id is string && userDoc.custom_role_id.size() > 0)
      );
    }

    // Staff / Editor / Custom-Role Operator Check (NOTE: uses get/exists, so NEVER call inside allow list)
    function isEditor() {
      return isMainAdmin() ||
        isBootstrappedOrdinaryAdmin() || (
          isSignedIn() &&
          (
            request.auth.token.email_verified == true ||
            request.auth.token.firebase.sign_in_provider == 'password'
          ) &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          isNonSuspendedStaffDoc(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        );
    }

    function isMainAdminProtectedSetting(settingId) {
      return settingId == "hero_banner_config" ||
        settingId == "homepage_config" ||
        settingId == "website_content_config" ||
        settingId == "media_library_config" ||
        settingId == "role_permissions" ||
        settingId == "site_config" ||
        settingId == "branding" ||
        settingId == "donation_config" ||
        settingId == "site_meta_config" ||
        settingId == "services_config" ||
        settingId == "app_packages_config" ||
        settingId == "divisions_config" ||
        settingId == "categories_config";
    }

    function isValidSiteSetting(data) {
      return data.keys().hasAll(['key', 'logo_url', 'visible', 'updatedAt']) &&
        data.keys().hasOnly(['key', 'logo_url', 'visible', 'updatedAt']) &&
        data.key is string && data.key.size() >= 1 && data.key.size() <= 80 &&
        data.logo_url is string && data.logo_url.size() >= 0 && data.logo_url.size() <= 300000 &&
        data.visible is bool &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['is_global', 'title', 'message', 'type', 'read', 'created_at']) &&
        data.is_global is bool &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1500 &&
        data.type is string && (data.type == 'info' || data.type == 'success' || data.type == 'warning' || data.type == 'status_update') &&
        data.read is bool &&
        (data.created_at is timestamp || (data.created_at is string && data.created_at.size() >= 1 && data.created_at.size() <= 64)) &&
        (!('user_id' in data) || (data.user_id is string && data.user_id.size() <= 128)) &&
        (!('link' in data) || (data.link is string && data.link.size() <= 500)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('priority' in data) || (data.priority == 'normal' || data.priority == 'high' || data.priority == 'urgent')) &&
        (!('audience' in data) || (data.audience == 'all_users' || data.audience == 'specific_users' || data.audience == 'all_admins' || data.audience == 'ordinary_admins' || data.audience == 'staff_editors')) &&
        (!('status' in data) || (data.status == 'created' || data.status == 'queued' || data.status == 'sent' || data.status == 'failed' || data.status == 'partial')) &&
        (!('scheduled_at' in data) || (data.scheduled_at is string && data.scheduled_at.size() <= 64)) &&
        (!('idempotency_key' in data) || (data.idempotency_key is string && data.idempotency_key.size() <= 128)) &&
        (!('channels' in data) || (data.channels is list && data.channels.size() <= 5 && (data.channels.size() == 0 || data.channels[0] is string)));
    }

    function isValidNotificationDelivery(data) {
      return data.keys().hasAll(['notification_id', 'channel', 'status', 'recipient', 'created_at']) &&
        data.notification_id is string && data.notification_id.size() >= 1 && data.notification_id.size() <= 128 &&
        data.channel is string && (data.channel == 'in_app' || data.channel == 'web_push' || data.channel == 'email') &&
        data.status is string && (data.status == 'queued' || data.status == 'sent' || data.status == 'failed') &&
        data.recipient is string && data.recipient.size() >= 1 && data.recipient.size() <= 300 &&
        data.created_at is string && data.created_at.size() >= 1 && data.created_at.size() <= 64 &&
        (!('error_message' in data) || (data.error_message is string && data.error_message.size() <= 1000));
    }

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // Connection Health Check (/test/{docId})
    // =========================================================
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    // =========================================================
    // 0. /settings/{settingId} (Hero Banner & Site Configuration)
    // =========================================================
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (resource == null || existing().visible == true || isMainAdmin() || isEditor());
      allow list: if existing().visible == true || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(settingId) && isValidSiteSetting(incoming()) &&
        incoming().key == settingId &&
        incoming().updatedAt == request.time && (
          isMainAdmin() ||
          (settingId == "staff_profiles_config" && isEditor())
        );
      allow update: if isValidId(settingId) && isValidSiteSetting(incoming()) &&
        incoming().key == settingId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['key', 'logo_url', 'visible', 'updatedAt']) && (
          isMainAdmin() ||
          (!isMainAdminProtectedSetting(settingId) && settingId == "staff_profiles_config" && isEditor())
        );
      allow delete: if isValidId(settingId) && isMainAdmin();
    }

    // =========================================================
    // 1. /admins/{adminId} (Main Admin Controlled)
    // =========================================================
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isMainAdmin() || isBootstrappedOrdinaryAdmin());
      allow list: if isMainAdmin();
      allow create, update: if isValidId(adminId) && isMainAdmin() &&
        incoming().uid is string && incoming().uid == adminId &&
        incoming().email is string && incoming().email.size() >= 3 && incoming().email.size() <= 254;
      allow delete: if isValidId(adminId) && isMainAdmin() &&
        existing().email != "mdmahmudulhashan0@gmail.com";
    }

    // =========================================================
    // 2. /users/{userId} & Subcollections (PII Isolated)
    // =========================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isMainAdmin());
      allow list: if (isSignedIn() && existing().uid == request.auth.uid) || isMainAdmin();
      allow create: if isValidId(userId) && (
        (isVerifiedUser() && isOwner(userId) &&
          incoming().uid == request.auth.uid &&
          (!('roles' in incoming()) || incoming().roles == ['user']) &&
          (!('suspended' in incoming()) || incoming().suspended == false)) ||
        (isMainAdmin() && incoming().uid == userId)
      );
      allow update: if isValidId(userId) && (
        isMainAdmin() || (
          isVerifiedUser() &&
          isOwner(userId) &&
          (!('suspended' in existing()) || existing().suspended == false) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().roles == existing().roles &&
          incoming().suspended == existing().suspended &&
          incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'username', 'phone', 'photo_url', 'must_change_password', 'updatedAt'])
        )
      );
      allow delete: if isValidId(userId) && isMainAdmin() &&
        existing().email != "mdmahmudulhashan0@gmail.com";

      // Per-user security audit logs
      match /security_events/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && (isOwner(userId) || isMainAdmin());
        allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
        allow create: if isValidId(userId) && isValidId(eventId) &&
          isSignedIn() && isOwner(userId) &&
          incoming().user_id == request.auth.uid &&
          incoming().user_id == userId;
        allow update, delete: if false;
      }

      // Per-user global notification read receipts (Least Privilege)
      match /notification_reads/{notifId} {
        allow get: if isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isMainAdmin());
        allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
        allow create, update: if isValidId(userId) && isValidId(notifId) &&
          isOwner(userId) &&
          incoming().keys().hasAll(['notif_id', 'user_id', 'read_at']) &&
          incoming().keys().hasOnly(['notif_id', 'user_id', 'read_at']) &&
          incoming().user_id == request.auth.uid &&
          incoming().notif_id == notifId &&
          incoming().read_at is string && incoming().read_at.size() <= 64;
        allow delete: if isValidId(userId) && isValidId(notifId) && (isOwner(userId) || isMainAdmin());
      }

      // Per-user device push tokens (Least Privilege, cleaned up on signOut)
      match /device_tokens/{tokenId} {
        allow get: if isValidId(userId) && isValidId(tokenId) && (isOwner(userId) || isMainAdmin());
        allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
        allow create, update: if isValidId(userId) && isValidId(tokenId) &&
          isOwner(userId) &&
          incoming().user_id == request.auth.uid &&
          incoming().user_id == userId &&
          incoming().platform is string && incoming().platform.size() <= 40 &&
          incoming().active is bool &&
          incoming().updated_at is string && incoming().updated_at.size() <= 64 &&
          (!('endpoint' in incoming()) || (incoming().endpoint is string && incoming().endpoint.size() <= 500)) &&
          (!('subscription_json' in incoming()) || (incoming().subscription_json is string && incoming().subscription_json.size() <= 2000));
        allow delete: if isValidId(userId) && isValidId(tokenId) && (isOwner(userId) || isMainAdmin());
      }

      // Per-user notification channel & category preferences
      match /notification_preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && (isOwner(userId) || isMainAdmin());
        allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
        allow create, update: if isValidId(userId) && isValidId(prefId) &&
          (isOwner(userId) || isMainAdmin()) &&
          incoming().user_id == userId &&
          incoming().in_app is bool &&
          incoming().web_push is bool &&
          incoming().email is bool &&
          incoming().muted_categories is list &&
          incoming().muted_categories.size() <= 10 &&
          (incoming().muted_categories.size() == 0 || incoming().muted_categories[0] is string) &&
          (!('email_address' in incoming()) || (incoming().email_address is string && incoming().email_address.size() <= 254));
        allow delete: if isValidId(userId) && isValidId(prefId) && (isOwner(userId) || isMainAdmin());
      }
    }

    // =========================================================
    // 3. /user_notifications/{notifId} (Fixed Notification Rules)
    // =========================================================
    match /user_notifications/{notifId} {
      allow get: if isValidId(notifId) && (
        resource == null ||
        existing().is_global == true ||
        (isSignedIn() && existing().user_id == request.auth.uid) ||
        isMainAdmin()
      );
      allow list: if existing().is_global == true ||
        (isSignedIn() && existing().user_id == request.auth.uid) ||
        isMainAdmin();
      allow create: if isMainAdmin() && isValidId(notifId) && isValidNotification(incoming());
      allow update: if isValidId(notifId) && (
        (isMainAdmin() && isValidNotification(incoming())) || (
          isSignedIn() &&
          existing().is_global == false &&
          existing().user_id == request.auth.uid &&
          incoming().user_id == existing().user_id &&
          incoming().is_global == existing().is_global &&
          incoming().title == existing().title &&
          incoming().message == existing().message &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updated_at']) &&
          incoming().read is bool
        )
      );
      allow delete: if isMainAdmin() && isValidId(notifId);
    }

    // =========================================================
    // 3b. /notification_deliveries/{deliveryId} (Main Admin Audit & Retry Log)
    // =========================================================
    match /notification_deliveries/{deliveryId} {
      allow get, list: if isMainAdmin();
      allow create, update: if isValidId(deliveryId) && isMainAdmin() && isValidNotificationDelivery(incoming());
      allow delete: if isValidId(deliveryId) && isMainAdmin();
    }

    // =========================================================
    // 3c. /admin_audit_logs/{logId} (Immutable Super Admin Audit Trail)
    // =========================================================
    match /admin_audit_logs/{logId} {
      allow get, list: if isMainAdmin();
      allow create: if isValidId(logId) && isMainAdmin() &&
        incoming().actor_email is string &&
        incoming().action is string && incoming().action.size() >= 1 && incoming().action.size() <= 40 &&
        incoming().module is string && incoming().module.size() >= 1 && incoming().module.size() <= 60 &&
        incoming().summary is string && incoming().summary.size() >= 1 && incoming().summary.size() <= 1000 &&
        (!('metadata_json' in incoming()) || (incoming().metadata_json is string && incoming().metadata_json.size() <= 5000));
      allow update, delete: if false;
    }

    // =========================================================
    // 4. /user_favorites/{favId} (Owner Isolated Bookmarks)
    // =========================================================
    match /user_favorites/{favId} {
      allow get: if isValidId(favId) && (
        (resource == null && isSignedIn()) ||
        (isSignedIn() && existing().user_id == request.auth.uid) ||
        isMainAdmin()
      );
      allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
      allow create: if isValidId(favId) && isSignedIn() &&
        incoming().user_id == request.auth.uid &&
        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 200;
      allow update, delete: if isValidId(favId) && ((isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin());
    }

    // =========================================================
    // 5. /donations/{donationId} (Main Admin Moderated)
    // =========================================================
    match /donations/{donationId} {
      allow get: if isValidId(donationId) && (resource == null || existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isMainAdmin());
      allow list: if existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isMainAdmin();
      allow create: if isValidId(donationId) && isSignedIn() &&
        incoming().author_id == request.auth.uid &&
        incoming().amount is number && incoming().amount > 0 &&
        (incoming().status == 'pending' || isMainAdmin());
      allow update: if isValidId(donationId) && (
        isMainAdmin() || (
          isVerifiedUser() &&
          existing().author_id == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().author_id == existing().author_id &&
          incoming().diff(existing()).affectedKeys().hasOnly(['note', 'updatedAt', 'updated_at'])
        )
      );
      allow delete: if isValidId(donationId) && isMainAdmin();
    }

    // =========================================================
    // 6. /expenses, /campaigns, /financial_audit_logs (Main Admin Only Writes)
    // =========================================================
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId) && (resource == null || existing().status == 'approved' || isMainAdmin());
      allow list: if existing().status == 'approved' || isMainAdmin();
      allow create, update, delete: if isValidId(expenseId) && isMainAdmin();
    }

    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && (resource == null || existing().visible == true || existing().status == 'active' || isMainAdmin());
      allow list: if existing().visible == true || existing().status == 'active' || isMainAdmin();
      allow create, update, delete: if isValidId(campaignId) && isMainAdmin();
    }

    match /financial_audit_logs/{logId} {
      allow get, list: if isMainAdmin();
      allow create: if isValidId(logId) && isMainAdmin();
      allow update, delete: if false;
    }

    // =========================================================
    // 7. /submissions/{submissionId}
    // =========================================================
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && (resource == null || existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isEditor());
      allow list: if existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(submissionId) && isSignedIn() && (
        isEditor() ||
        (incoming().author_id == request.auth.uid && incoming().status == 'pending')
      );
      allow update: if isValidId(submissionId) && (
        isEditor() || (
          isSignedIn() &&
          existing().author_id == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().author_id == existing().author_id
        )
      );
      allow delete: if isValidId(submissionId) && isMainAdmin();
    }

    // =========================================================
    // 8. /blood_donors/{donorId} & /donation_events/{eventId}
    // =========================================================
    match /blood_donors/{donorId} {
      allow get: if isValidId(donorId) && (resource == null || existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isEditor());
      allow list: if existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(donorId) && isSignedIn() && (
        isMainAdmin() || (
          !donorId.matches('^imp_bd_.*') &&
          !('import_source' in incoming()) &&
          !('source_row' in incoming()) && (
            isEditor() ||
            (incoming().author_id == request.auth.uid && incoming().status == 'pending')
          )
        )
      );
      allow update: if isValidId(donorId) && (
        isMainAdmin() || (
          !('import_source' in incoming().diff(existing()).affectedKeys()) &&
          !('source_row' in incoming().diff(existing()).affectedKeys()) && (
            isEditor() || (
              isSignedIn() &&
              existing().author_id == request.auth.uid &&
              existing().status == 'pending' &&
              incoming().status == 'pending' &&
              incoming().author_id == existing().author_id
            )
          )
        )
      );
      allow delete: if isValidId(donorId) && isMainAdmin();
    }

    match /donation_events/{eventId} {
      allow get: if isValidId(eventId) && (resource == null || existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isEditor());
      allow list: if existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(eventId) && isSignedIn() && (
        isEditor() || (
          incoming().author_id == request.auth.uid &&
          incoming().status == 'pending' &&
          exists(/databases/$(database)/documents/blood_donors/$(incoming().donor_id))
        )
      );
      allow update: if isValidId(eventId) && (
        isEditor() || (
          isSignedIn() &&
          existing().author_id == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().author_id == existing().author_id
        )
      );
      allow delete: if isValidId(eventId) && isMainAdmin();
    }

    // =========================================================
    // 9. /emergency_banners/{bannerId} & /emergency_blood_requests/{requestId}
    // =========================================================
    match /emergency_banners/{bannerId} {
      allow get: if isValidId(bannerId) && (resource == null || existing().visible == true || isEditor());
      allow list: if existing().visible == true || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create, update: if isValidId(bannerId) && isEditor();
      allow delete: if isValidId(bannerId) && isMainAdmin();
    }

    match /emergency_blood_requests/{requestId} {
      allow get: if isValidId(requestId) && (resource == null || existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isEditor());
      allow list: if existing().status == 'approved' || (isSignedIn() && existing().author_id == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(requestId) && isSignedIn() && (
        isEditor() ||
        (incoming().author_id == request.auth.uid && incoming().status == 'pending')
      );
      allow update: if isValidId(requestId) && (
        isEditor() || (
          isSignedIn() &&
          existing().author_id == request.auth.uid &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().author_id == existing().author_id
        )
      );
      allow delete: if isValidId(requestId) && isMainAdmin();
    }

    // =========================================================
    // 10. /categories & /departments
    // =========================================================
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (resource == null || existing().visible != false || isEditor());
      allow list: if existing().visible != false || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create, update: if isValidId(categoryId) && isEditor();
      allow delete: if isValidId(categoryId) && isMainAdmin();
    }

    match /departments/{departmentId} {
      allow get: if isValidId(departmentId) && (resource == null || existing().visible != false || isEditor());
      allow list: if existing().visible != false || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create, update: if isValidId(departmentId) && isEditor();
      allow delete: if isValidId(departmentId) && isMainAdmin();
    }

    // =========================================================
    // 11. /institutions, /job_circulars, /complaint_tracking
    // =========================================================
    match /institutions/{institutionId} {
      allow get: if isValidId(institutionId) && (resource == null || existing().status == 'approved' || (isSignedIn() && existing().submitted_by_uid == request.auth.uid) || isEditor());
      allow list: if existing().status == 'approved' || (isSignedIn() && existing().submitted_by_uid == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(institutionId) && isSignedIn() && (isEditor() || incoming().status == 'pending');
      allow update: if isValidId(institutionId) && isEditor();
      allow delete: if isValidId(institutionId) && isMainAdmin();
    }

    match /job_circulars/{circularId} {
      allow get: if isValidId(circularId) && (resource == null || existing().status == 'approved' || isEditor());
      allow list: if existing().status == 'approved' || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(circularId) && isSignedIn() && (isEditor() || incoming().status == 'pending');
      allow update: if isValidId(circularId) && isEditor();
      allow delete: if isValidId(circularId) && isMainAdmin();
    }

    match /complaint_tracking/{complaintId} {
      allow get: if isValidId(complaintId);
      allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(complaintId) && isSignedIn() && incoming().status == 'submitted';
      allow update: if isValidId(complaintId) && isEditor();
      allow delete: if isValidId(complaintId) && isMainAdmin();
    }

    // =========================================================
    // 12. /app_links, /category_access, /category_requests, /payment_requests
    // =========================================================
    match /app_links/{linkId} {
      allow get: if isValidId(linkId) && (resource == null || existing().visible == true || isMainAdmin());
      allow list: if existing().visible == true || isMainAdmin();
      allow create, update, delete: if isValidId(linkId) && isMainAdmin();
    }

    match /category_access/{accessId} {
      allow get: if isValidId(accessId) && ((resource == null && isSignedIn()) || (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin());
      allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
      allow create, update, delete: if isValidId(accessId) && isMainAdmin();
    }

    match /category_requests/{requestId} {
      allow get: if isValidId(requestId) && ((resource == null && isSignedIn()) || (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin());
      allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
      allow create: if isValidId(requestId) && isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isValidId(requestId) && isMainAdmin();
    }

    match /payment_requests/{requestId} {
      allow get: if isValidId(requestId) && ((resource == null && isSignedIn()) || (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin());
      allow list: if (isSignedIn() && existing().user_id == request.auth.uid) || isMainAdmin();
      allow create: if isValidId(requestId) && isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isValidId(requestId) && isMainAdmin();
    }

    // =========================================================
    // 13. /tasks/{taskId}
    // =========================================================
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && ((resource == null && isSignedIn()) || (isSignedIn() && existing().createdByUid == request.auth.uid) || isEditor());
      allow list: if (isSignedIn() && existing().createdByUid == request.auth.uid) || isMainAdmin() || isBootstrappedOrdinaryAdmin();
      allow create: if isValidId(taskId) && isSignedIn() && incoming().createdByUid == request.auth.uid;
      allow update: if isValidId(taskId) && ((isSignedIn() && existing().createdByUid == request.auth.uid) || isEditor());
      allow delete: if isValidId(taskId) && ((isSignedIn() && existing().createdByUid == request.auth.uid) || isMainAdmin());
    }

    // =========================================================
    // 14. /chat_threads/{threadId} & Subcollection /messages
    // =========================================================
    function isChatThreadCustomer(data) {
      return isSignedIn() && (
        data.user_id == request.auth.uid ||
        ('customer_uid' in data && data.customer_uid == request.auth.uid)
      );
    }

    function isChatThreadListedStaff(data) {
      return isSignedIn() && (
        ('assigned_to_uid' in data && data.assigned_to_uid == request.auth.uid) ||
        ('staff_uids' in data && data.staff_uids is list && request.auth.uid in data.staff_uids)
      );
    }

    function isValidChatThreadWrite(data) {
      return data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
        (!('customer_uid' in data) || (data.customer_uid is string && data.customer_uid.size() <= 128)) &&
        (!('user_name' in data) || (data.user_name is string && data.user_name.size() <= 150)) &&
        (!('user_email' in data) || (data.user_email is string && data.user_email.size() <= 254)) &&
        (!('last_message_at' in data) || (data.last_message_at is string && data.last_message_at.size() <= 64)) &&
        (!('last_message_preview' in data) || (data.last_message_preview is string && data.last_message_preview.size() <= 300)) &&
        (!('assigned_to_uid' in data) || (data.assigned_to_uid is string && data.assigned_to_uid.size() <= 128)) &&
        (!('assigned_to_name' in data) || (data.assigned_to_name is string && data.assigned_to_name.size() <= 150)) &&
        (!('assigned_role' in data) || (data.assigned_role is string && data.assigned_role.size() <= 120)) &&
        (!('handoff_summary' in data) || (data.handoff_summary is string && data.handoff_summary.size() <= 1000)) &&
        (!('staff_uids' in data) || (data.staff_uids is list && data.staff_uids.size() <= 50));
    }

    function isValidChatMessageCreate(threadId, data) {
      return data.keys().hasAll(['thread_id', 'sender_id', 'sender_role', 'body', 'attachment_url', 'createdAt']) &&
        data.thread_id == threadId &&
        data.sender_id == request.auth.uid &&
        data.sender_role is string && (data.sender_role == 'user' || data.sender_role == 'staff') &&
        data.body is string && data.body.size() <= 2000 &&
        data.attachment_url is string && data.attachment_url.size() <= 300000 &&
        (!('customer_uid' in data) || (data.customer_uid is string && data.customer_uid.size() <= 128)) &&
        (!('assigned_to_uid' in data) || (data.assigned_to_uid is string && data.assigned_to_uid.size() <= 128)) &&
        (!('sender_name' in data) || (data.sender_name is string && data.sender_name.size() <= 150)) &&
        (!('sender_photo' in data) || (data.sender_photo is string && data.sender_photo.size() <= 300000)) &&
        (!('sender_role_label' in data) || (data.sender_role_label is string && data.sender_role_label.size() <= 120)) &&
        (!('staff_uids' in data) || (data.staff_uids is list && data.staff_uids.size() <= 50)) &&
        data.createdAt == request.time;
    }

    match /chat_threads/{threadId} {
      allow get: if isValidId(threadId) && (
        (resource == null && isSignedIn()) ||
        isChatThreadCustomer(existing()) ||
        isChatThreadListedStaff(existing()) ||
        isEditor()
      );
      allow list: if isMainAdmin() ||
        isBootstrappedOrdinaryAdmin() ||
        (isSignedIn() && existing().user_id == request.auth.uid) ||
        (isSignedIn() && 'customer_uid' in existing() && existing().customer_uid == request.auth.uid) ||
        (isSignedIn() && 'assigned_to_uid' in existing() && existing().assigned_to_uid == request.auth.uid) ||
        (isSignedIn() && 'staff_uids' in existing() && existing().staff_uids is list && request.auth.uid in existing().staff_uids);
      allow create: if isValidId(threadId) && isSignedIn() &&
        isValidChatThreadWrite(incoming()) && (
          incoming().user_id == request.auth.uid ||
          ('customer_uid' in incoming() && incoming().customer_uid == request.auth.uid) ||
          isEditor()
        );
      allow update: if isValidId(threadId) && isSignedIn() &&
        isValidChatThreadWrite(incoming()) && (
          isMainAdmin() ||
          (
            isChatThreadCustomer(existing()) &&
            incoming().user_id == existing().user_id
          ) ||
          (
            (isChatThreadListedStaff(existing()) || isEditor()) &&
            incoming().user_id == existing().user_id
          )
        );
      allow delete: if isValidId(threadId) && isMainAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(threadId) && isValidId(messageId) && (
          isChatThreadCustomer(get(/databases/$(database)/documents/chat_threads/$(threadId)).data) ||
          isChatThreadListedStaff(get(/databases/$(database)/documents/chat_threads/$(threadId)).data) ||
          isEditor()
        );
        allow list: if isMainAdmin() ||
          isBootstrappedOrdinaryAdmin() ||
          (isSignedIn() && existing().thread_id == request.auth.uid) ||
          (isSignedIn() && 'customer_uid' in existing() && existing().customer_uid == request.auth.uid) ||
          (isSignedIn() && 'assigned_to_uid' in existing() && existing().assigned_to_uid == request.auth.uid) ||
          (isSignedIn() && 'staff_uids' in existing() && existing().staff_uids is list && request.auth.uid in existing().staff_uids);
        allow create: if isValidId(threadId) && isValidId(messageId) && isSignedIn() &&
          isValidChatMessageCreate(threadId, incoming()) && (
            isChatThreadCustomer(get(/databases/$(database)/documents/chat_threads/$(threadId)).data) ||
            isChatThreadListedStaff(get(/databases/$(database)/documents/chat_threads/$(threadId)).data) ||
            isEditor()
          );
        allow update: if isValidId(threadId) && isValidId(messageId) &&
          (isMainAdmin() || isEditor()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['staff_uids', 'assigned_to_uid', 'customer_uid']) &&
          (!('staff_uids' in incoming()) || (incoming().staff_uids is list && incoming().staff_uids.size() <= 50)) &&
          (!('assigned_to_uid' in incoming()) || (incoming().assigned_to_uid is string && incoming().assigned_to_uid.size() <= 128)) &&
          (!('customer_uid' in incoming()) || (incoming().customer_uid is string && incoming().customer_uid.size() <= 128));
        allow delete: if isValidId(threadId) && isValidId(messageId) && isMainAdmin();
      }
    }
  }
}
