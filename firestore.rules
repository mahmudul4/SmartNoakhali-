rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Global Hardened Primitives
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Main Admin: mdmahmudulhashan0@gmail.com
    function isMainAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "mdmahmudulhashan0@gmail.com";
    }

    // Secondary Admin: mr.bear444plus@gmail.com
    function isSecondaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "mr.bear444plus@gmail.com";
    }

    // Staff check: Main Admin, Secondary Admin, or role assigned in /users/{uid}
    function isEditor() {
      return isSignedIn() && (
        isMainAdmin() ||
        isSecondaryAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          'editor' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles ||
          'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        ))
      );
    }

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check for connection validation
    match /test/{docId} {
      allow get: if true;
    }

    // =========================================================
    // Tasks: /tasks/{taskId}
    // =========================================================
    match /tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && incoming().createdByUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isEditor() || (isSignedIn() && existing().createdByUid == request.auth.uid);
    }

    // =========================================================
    // 1. /admins/{adminId}
    // =========================================================
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isMainAdmin() || isSecondaryAdmin();
    }

    // =========================================================
    // 2. /users/{userId} & Subcollection /security_events
    // =========================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isEditor();
      allow list: if isMainAdmin() || isSecondaryAdmin();
      allow create: if isOwner(userId) && (!('roles' in incoming()) || incoming().roles == ['user']);
      allow update: if isMainAdmin() || isSecondaryAdmin() || (isOwner(userId) && (!incoming().diff(existing()).affectedKeys().hasAny(['roles', 'suspended', 'email'])));
      allow delete: if isMainAdmin() || isSecondaryAdmin();

      match /security_events/{eventId} {
        allow read, write: if isOwner(userId) || isMainAdmin() || isSecondaryAdmin();
      }
    }

    // =========================================================
    // 3. /donations/{donationId}
    // =========================================================
    match /donations/{donationId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(donationId);
    }

    // =========================================================
    // 4. /submissions/{submissionId}
    // =========================================================
    match /submissions/{submissionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(submissionId);
    }

    // =========================================================
    // 5. /blood_donors/{donorId}
    // =========================================================
    match /blood_donors/{donorId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(donorId);
    }

    // =========================================================
    // 6. /donation_events/{eventId}
    // =========================================================
    match /donation_events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(eventId);
    }

    // =========================================================
    // 7. /emergency_banners/{bannerId}
    // =========================================================
    match /emergency_banners/{bannerId} {
      allow get, list: if true;
      allow write: if isValidId(bannerId);
    }

    // =========================================================
    // 8. /app_links/{linkId}
    // =========================================================
    match /app_links/{linkId} {
      allow get, list: if true;
      allow write: if isValidId(linkId);
    }

    // =========================================================
    // 9. /emergency_blood_requests/{requestId}
    // =========================================================
    match /emergency_blood_requests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    // =========================================================
    // 10. /category_access/{accessId}
    // =========================================================
    match /category_access/{accessId} {
      allow get, list: if true;
      allow write: if isValidId(accessId);
    }

    // =========================================================
    // 11. /category_requests/{requestId}
    // =========================================================
    match /category_requests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    // =========================================================
    // 12. /payment_requests/{requestId}
    // =========================================================
    match /payment_requests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    // =========================================================
    // 13. /settings/{settingId} (Site Logo, Categories, Packages, Services, etc.)
    // =========================================================
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isValidId(settingId);
    }

    // =========================================================
    // 14. /categories/{categoryId}
    // =========================================================
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isValidId(categoryId);
    }

    // =========================================================
    // 15. /chat_threads/{threadId} & Subcollection /messages
    // =========================================================
    match /chat_threads/{threadId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(threadId);

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(messageId);
      }
    }

    // =========================================================
    // 16. /expenses/{expenseId} (Relief & Humanitarian Expenses)
    // =========================================================
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(expenseId);
    }

    // =========================================================
    // 17. /campaigns/{campaignId} (Donation Campaigns)
    // =========================================================
    match /campaigns/{campaignId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(campaignId);
    }

    // =========================================================
    // 18. /financial_audit_logs/{logId} (Financial Audit Trail)
    // =========================================================
    match /financial_audit_logs/{logId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(logId);
    }
  }
}
